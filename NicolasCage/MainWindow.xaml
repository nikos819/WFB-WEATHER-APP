<Window x:Class="PogodaPoznan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pogoda" Height="292" Width="334"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Pogoda - Ostrzeszów"
                   FontSize="26"
                   HorizontalAlignment="Center"
                   Margin="0,10" FontWeight="Bold"/>

        <TextBlock x:Name="Temperatura"
                   Text="Temperatura: -- °C"
                   FontSize="18"
                   Margin="0,15,0,5"/>

        <TextBlock x:Name="Opis"
                   Text="Pogoda: pobieranie..."
                   FontSize="16"
                   Margin="0,5,0,15"/>

        <Button Content="Sprawdź pogodę"
                FontSize="20"
                Background="Aquamarine"
                Height="35"
                Click="Button_Click"
                BorderBrush="Aqua" Width="242" FontWeight="Bold"/>

        <TextBlock x:Name="Status"
                   Text=""
                   Margin="0,10"
                   TextWrapping="Wrap"/>

    </StackPanel>
</Window>
